options:
  parameters:
    id: pluto_rx_record
    title: OFDM ISAC RX recorder (PlutoSDR)
    author: Amirreza Piri
    description: 'Records n_samples from the PlutoSDR to grc/grc_capture.cf32 (full scale = 1.0). Process with: python3 ../scripts/process_capture.py
      grc_capture.cf32 --config ../config/indoor.yaml'
    generate_options: no_gui
    output_language: python
    run: 'True'
    run_options: run
    window_size: (1400, 900)
    category: '[GRC Hier Blocks]'
  states:
    coordinate:
    - 8
    - 8
    rotation: 0
    state: enabled
blocks:
- name: samp_rate
  id: variable
  parameters:
    value: '4000000'
  states:
    coordinate:
    - 200
    - 12
    rotation: 0
    state: enabled
- name: fc
  id: variable
  parameters:
    value: '2450000000'
  states:
    coordinate:
    - 300
    - 12
    rotation: 0
    state: enabled
- name: rf_bw
  id: variable
  parameters:
    value: '4000000'
  states:
    coordinate:
    - 400
    - 12
    rotation: 0
    state: enabled
- name: rx_gain
  id: variable
  parameters:
    value: '30'
  states:
    coordinate:
    - 500
    - 12
    rotation: 0
    state: enabled
- name: n_samples
  id: variable
  parameters:
    value: '4194304'
  states:
    coordinate:
    - 600
    - 12
    rotation: 0
    state: enabled
- name: out_file
  id: variable
  parameters:
    value: '''grc_capture.cf32'''
  states:
    coordinate:
    - 720
    - 12
    rotation: 0
    state: enabled
- name: pluto_source
  id: iio_pluto_source
  parameters:
    type: fc32
    uri: ''''''
    frequency: fc
    samplerate: samp_rate
    buffer_size: '131072'
    gain1: '''manual'''
    manual_gain1: rx_gain
    quadrature: 'True'
    rfdc: 'True'
    bbdc: 'True'
    bandwidth: rf_bw
    filter_source: '''Auto'''
    len_tag_key: packet_len
  states:
    coordinate:
    - 16
    - 200
    rotation: 0
    state: enabled
- name: head
  id: blocks_head
  parameters:
    type: complex
    num_items: n_samples
    vlen: '1'
  states:
    coordinate:
    - 300
    - 220
    rotation: 0
    state: enabled
- name: record
  id: blocks_file_sink
  parameters:
    file: out_file
    type: complex
    vlen: '1'
    unbuffered: 'False'
    append: 'False'
  states:
    coordinate:
    - 500
    - 210
    rotation: 0
    state: enabled
connections:
- - pluto_source
  - '0'
  - head
  - '0'
- - head
  - '0'
  - record
  - '0'
metadata:
  file_format: 1
  grc_version: 3.10.9.2
