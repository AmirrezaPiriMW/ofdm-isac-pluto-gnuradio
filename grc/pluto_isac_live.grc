options:
  parameters:
    id: pluto_isac_live
    title: OFDM ISAC live (PlutoSDR)
    author: Amirreza Piri
    description: 'One PlutoSDR, bistatic OFDM ISAC: TX1 plays the cyclic OFDM buffer, RX1 feeds the live radar block (Doppler
      display + detections) and the comm decoder.'
    generate_options: qt_gui
    output_language: python
    run: 'True'
    run_options: prompt
    window_size: (1400, 900)
    category: '[GRC Hier Blocks]'
  states:
    coordinate:
    - 8
    - 8
    rotation: 0
    state: enabled
blocks:
- name: samp_rate
  id: variable
  parameters:
    value: '4000000'
  states:
    coordinate:
    - 200
    - 12
    rotation: 0
    state: enabled
- name: fc
  id: variable
  parameters:
    value: '2450000000'
  states:
    coordinate:
    - 300
    - 12
    rotation: 0
    state: enabled
- name: rf_bw
  id: variable
  parameters:
    value: '4000000'
  states:
